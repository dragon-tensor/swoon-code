# Cookies — never commit your session
cookies*.json
!cookies.example.json
*.updated
cookies.json.state

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
.env
venv/
.venv/
codebase/.local/
setup/.runtime/

# Consumer workspaces — keep only the empty public input/output roots
work/.sessions/
work/input/*
!work/input/.gitkeep
work/output/*
!work/output/.gitkeep



# Playwright browsers (large binaries)
playwright-browsers/
chatgpt-browsers/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Debug screenshots
tmp/
debug.png
chatgpt_debug.png
